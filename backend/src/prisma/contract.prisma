// ========================================
// ENUMS
// ========================================

// Perfis de acesso do sistema
enum TipoUsuario {
  ADMIN
  MEDICO
  PACIENTE
}

// Status possíveis de um agendamento
enum StatusAgendamento {
  AGENDADA
  PENDENTE
  CONFIRMADA
  REALIZADA
  RECUSADA
  CANCELADA
  FALTOU
}

// Status possíveis de uma solicitação
// de remarcação de consulta.
//
// PENDENTE:
// paciente solicitou um novo horário
// e aguarda a decisão do médico.
//
// ACEITA:
// médico aprovou o novo horário.
//
// RECUSADA:
// médico recusou o novo horário.
enum StatusRemarcacao {
  PENDENTE
  ACEITA
  RECUSADA
}


// ========================================
// USUÁRIO
// ========================================

// Usuários que podem acessar o sistema
model Usuario {
  id             Int               @id @default(autoincrement())
  nome           String
  email          String            @unique

  // A senha agora é opcional.
  //
  // Isso permite que um usuário recém-criado,
  // principalmente o PACIENTE, ainda não possua
  // uma senha antes de concluir o primeiro acesso.
  //
  // Exemplo:
  //
  // Médico libera acesso do paciente
  //        ↓
  // Usuario é criado
  //        ↓
  // senha = null
  // primeiroAcesso = true
  //
  // Depois que o paciente validar o código
  // recebido por email e criar sua senha:
  //
  // senha = hash bcrypt
  // primeiroAcesso = false
  senha          String?

  tipo           TipoUsuario
  ativo          Boolean           @default(true)

  // Indica se o usuário ainda precisa
  // concluir o processo de primeiro acesso.
  primeiroAcesso Boolean           @default(true)

  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  // ========================================
  // RELACIONAMENTOS
  // ========================================

  medico   Medico?
  paciente Paciente?

  // Códigos utilizados exclusivamente
  // na recuperação de senha.
  //
  // Fluxo:
  // "Esqueci minha senha"
  codigosRedefinicao CodigoRedefinicaoSenha[]

  // Códigos utilizados exclusivamente
  // para a criação da primeira senha.
  //
  // Fluxo:
  // "Primeiro acesso"
  codigosPrimeiroAcesso CodigoPrimeiroAcesso[]
}


// ========================================
// MÉDICO
// ========================================

// Dados específicos do médico
model Medico {
  id        Int    @id @default(autoincrement())
  usuarioId Int    @unique
  crm       String @unique

  // Usuário relacionado ao médico
  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id]
  )

  // Pacientes pertencentes ao médico
  pacientes Paciente[]

  // Disponibilidades cadastradas
  // pelo médico na agenda
  disponibilidades DisponibilidadeAgenda[]

  // Consultas/agendamentos relacionados
  // ao médico
  agendamentos Agendamento[]
}


// ========================================
// PACIENTE
// ========================================

// Dados dos pacientes cadastrados
// pelo médico
model Paciente {
  id        Int  @id @default(autoincrement())
  medicoId  Int
  usuarioId Int? @unique

  nome     String
  email    String?
  telefone String?
  cpf      String? @unique

  // Indica se o médico liberou
  // o acesso do paciente ao sistema
  acessoLiberado Boolean @default(false)

  // Exclusão/bloqueio lógico
  ativo Boolean @default(true)

  // Médico responsável
  medico Medico @relation(
    fields: [medicoId],
    references: [id]
  )

  // Usuário utilizado para login.
  //
  // Pode ser null enquanto o médico ainda
  // não tiver liberado o acesso do paciente.
  usuario Usuario? @relation(
    fields: [usuarioId],
    references: [id]
  )

  // Consultas do paciente
  agendamentos Agendamento[]
}


// ========================================
// DISPONIBILIDADE DA AGENDA
// ========================================

// Representa os períodos que o médico
// disponibilizou para atendimento.
//
// Exemplo:
//
// 15/09/2026
// 08:00 até 12:00
// duração de consulta: 30 minutos
model DisponibilidadeAgenda {
  id Int @id @default(autoincrement())

  medicoId Int
  data     DateString

  horaInicio String
  horaFim    String

  duracaoConsulta Int @default(30)

  // Permite exclusão lógica sem
  // remover o histórico do banco
  ativo Boolean @default(true)

  // Médico proprietário
  medico Medico @relation(
    fields: [medicoId],
    references: [id]
  )

  // Facilita consultas por médico e data
  @@index([medicoId, data])
}


// ========================================
// AGENDAMENTO
// ========================================

// Representa uma consulta reservada
// por um paciente.
//
// IMPORTANTE:
//
// O paciente só poderá criar um
// agendamento usando horários que
// tenham sido disponibilizados
// anteriormente pelo médico.
model Agendamento {
  id Int @id @default(autoincrement())

  // Médico da consulta
  medicoId Int

  // Paciente da consulta
  pacienteId Int

  // Data da consulta
  data DateString

  // Horário inicial
  horaInicio String

  // Horário final
  horaFim String

  // Estado atual da consulta
  status StatusAgendamento @default(PENDENTE)

  // Controle de criação e atualização
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  // ========================================
  // RELACIONAMENTOS
  // ========================================

  medico Medico @relation(
    fields: [medicoId],
    references: [id]
  )

  paciente Paciente @relation(
    fields: [pacienteId],
    references: [id]
  )

  // Histórico das solicitações de
  // remarcação desta consulta.
  //
  // Uma consulta pode possuir várias
  // solicitações ao longo do tempo.
  remarcacoes RemarcacaoAgendamento[]

  // ========================================
  // ÍNDICES
  // ========================================

  // Usado para buscar rapidamente
  // a agenda diária de um médico
  @@index([medicoId, data])

  // Usado para buscar consultas
  // pertencentes a um paciente
  @@index([pacienteId, data])

  // Ajuda na validação se determinado
  // horário já está ocupado
  @@index([medicoId, data, horaInicio])
}


// ========================================
// REMARCAÇÃO DE AGENDAMENTO
// ========================================

// Representa uma solicitação feita
// pelo paciente para mudar a data
// e/ou horário de uma consulta.
//
// IMPORTANTE:
//
// A consulta original NÃO será alterada
// enquanto o médico não aceitar
// a solicitação.
//
// Exemplo:
//
// Consulta atual:
// 18/09/2026 - 14:00
//
// Paciente solicita:
// 20/09/2026 - 09:30
//
// Enquanto estiver PENDENTE,
// o Agendamento continua apontando
// para 18/09/2026 - 14:00.
//
// Se o médico aceitar, o Agendamento
// será atualizado para o novo horário.
//
// Se recusar, a consulta original
// continuará normalmente.
model RemarcacaoAgendamento {
  id Int @id @default(autoincrement())

  // ========================================
  // AGENDAMENTO
  // ========================================

  // Consulta que o paciente
  // deseja remarcar
  agendamentoId Int

  // ========================================
  // NOVO HORÁRIO
  // ========================================

  // Nova data solicitada
  novaData DateString

  // Novo horário inicial solicitado
  novaHoraInicio String

  // Novo horário final solicitado
  novaHoraFim String

  // ========================================
  // STATUS
  // ========================================

  // A solicitação nasce como PENDENTE.
  //
  // Depois o médico poderá alterar para:
  //
  // ACEITA
  // ou
  // RECUSADA
  status StatusRemarcacao @default(PENDENTE)

  // ========================================
  // VISUALIZAÇÃO PELO PACIENTE
  // ========================================

  // Indica se o paciente já visualizou
  // a resposta do médico.
  //
  // Quando o médico aceita ou recusa,
  // permanece false.
  //
  // Assim o frontend consegue mostrar:
  //
  // "Sua remarcação foi aceita"
  //
  // ou
  //
  // "Sua remarcação foi recusada".
  //
  // Quando o paciente clicar em
  // "Entendi", será alterado para true.
  //
  // O registro continua no banco
  // para manter o histórico.
  visualizadoPaciente Boolean @default(false)

  // ========================================
  // CONTROLE
  // ========================================

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  // ========================================
  // RELACIONAMENTO
  // ========================================

  agendamento Agendamento @relation(
    fields: [agendamentoId],
    references: [id]
  )

  // ========================================
  // ÍNDICES
  // ========================================

  // Facilita buscar as remarcações
  // de determinada consulta.
  @@index([agendamentoId])

  // Facilita buscar, por exemplo,
  // todas as solicitações PENDENTES.
  @@index([status])
}


// ========================================
// REDEFINIÇÃO DE SENHA
// ========================================

// Códigos temporários utilizados
// exclusivamente na recuperação de senha.
//
// Este model continuará responsável pelo:
//
// "Esqueci minha senha"
//
// Ele NÃO será utilizado para o
// novo fluxo de primeiro acesso.
model CodigoRedefinicaoSenha {
  id Int @id @default(autoincrement())

  usuarioId Int

  codigo String

  expiraEm TimestamptzString

  usado Boolean @default(false)

  createdAt TimestamptzString @default(now())

  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id]
  )
}


// ========================================
// PRIMEIRO ACESSO
// ========================================

// Códigos temporários utilizados
// exclusivamente no primeiro acesso.
//
// Este fluxo será utilizado quando o
// usuário ainda NÃO possui senha.
//
// Exemplo:
//
// Médico libera acesso
//        ↓
// Usuario é criado
// senha = null
// primeiroAcesso = true
//        ↓
// Paciente solicita primeiro acesso
//        ↓
// Sistema gera código de 6 dígitos
//        ↓
// Código é enviado pela Brevo
//        ↓
// Paciente informa:
// - código
// - nova senha
// - confirmação da senha
//        ↓
// Backend valida
//        ↓
// senha recebe hash bcrypt
// primeiroAcesso = false
model CodigoPrimeiroAcesso {
  id Int @id @default(autoincrement())

  // Usuário responsável pelo
  // processo de primeiro acesso.
  usuarioId Int

  // IMPORTANTE:
  //
  // Diferentemente da estrutura antiga
  // de redefinição de senha, neste novo
  // fluxo não armazenaremos diretamente
  // o código de 6 dígitos.
  //
  // O backend irá gerar:
  //
  // 483921
  //
  // mas o banco receberá apenas
  // o hash correspondente.
  codigoHash String

  // Momento em que o código
  // deixa de ser válido.
  expiraEm TimestamptzString

  // Impede que o mesmo código
  // seja utilizado novamente.
  usado Boolean @default(false)

  // Quantidade de tentativas incorretas
  // realizadas com este código.
  //
  // Posteriormente o service limitará
  // a quantidade permitida.
  tentativas Int @default(0)

  // Momento em que o código foi criado.
  //
  // Além do histórico, poderá ser usado
  // para controlar reenvios muito rápidos.
  createdAt TimestamptzString @default(now())

  // ========================================
  // RELACIONAMENTO
  // ========================================

  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id]
  )

  // ========================================
  // ÍNDICES
  // ========================================

  // Facilita localizar rapidamente os
  // códigos pertencentes ao usuário.
  @@index([usuarioId])

  // Facilita a busca pelos códigos
  // ativos/não utilizados do usuário.
  @@index([usuarioId, usado])
}