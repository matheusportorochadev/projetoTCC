
 // ========================================
 // ENUMS
 // ========================================

 // Perfis de acesso do sistema
 enum TipoUsuario {
   ADMIN
   MEDICO
   PACIENTE
 }

 // Status possíveis de um agendamento
 enum StatusAgendamento {
   AGENDADA
   PENDENTE
   CONFIRMADA
   REALIZADA
   RECUSADA
   CANCELADA
   FALTOU
 }

 // Status possíveis de uma solicitação
 // de remarcação de consulta.
 //
 // PENDENTE:
 // paciente solicitou um novo horário
 // e aguarda a decisão do médico.
 //
 // ACEITA:
 // médico aprovou o novo horário.
 //
 // RECUSADA:
 // médico recusou o novo horário.
 enum StatusRemarcacao {
   PENDENTE
   ACEITA
   RECUSADA
 }


 // ========================================
 // USUÁRIO
 // ========================================

 // Usuários que podem acessar o sistema
 // Revogação independente do cadastro: não armazena JWT ou conteúdo clínico.
 // A chave primária permite verificar cada sessão com uma busca indexada.
 model SessaoRevogada {
   tokenHash String @id
   usuarioId Int
   expiresAt TimestamptzString
   createdAt TimestamptzString @default(now())

   @@index([expiresAt])
   @@index([usuarioId])
 }

 model Usuario {
   id             Int               @id @default(autoincrement())
   nome           String
   email          String            @unique

   // A senha agora é opcional.
   //
   // Isso permite que um usuário recém-criado,
   // principalmente o PACIENTE, ainda não possua
   // uma senha antes de concluir o primeiro acesso.
   //
   // Exemplo:
   //
   // Médico libera acesso do paciente
   //        ↓
   // Usuario é criado
   //        ↓
   // senha = null
   // primeiroAcesso = true
   //
   // Depois que o paciente validar o código
   // recebido por email e criar sua senha:
   //
   // senha = hash bcrypt
   // primeiroAcesso = false
   senha          String?

   tipo           TipoUsuario
   ativo          Boolean           @default(true)

   // Indica se o usuário ainda precisa
   // concluir o processo de primeiro acesso.
   primeiroAcesso Boolean           @default(true)

   // Incrementada atomicamente na redefinição da senha principal.
   versaoSessao   Int               @default(0)

   createdAt      TimestamptzString @default(now())
   updatedAt      temporal.updatedAtString()

   // ========================================
   // RELACIONAMENTOS
   // ========================================

   medico   Medico?
   paciente Paciente?

   // Códigos utilizados exclusivamente
   // na recuperação de senha.
   //
   // Fluxo:
   // "Esqueci minha senha"
   codigosRedefinicao CodigoRedefinicaoSenha[]

   // Códigos utilizados exclusivamente
   // para a criação da primeira senha.
   //
   // Fluxo:
   // "Primeiro acesso"
   codigosPrimeiroAcesso CodigoPrimeiroAcesso[]
 }


 // ========================================
 // MÉDICO
 // ========================================

 // Dados específicos do médico
 model Medico {
   id        Int    @id @default(autoincrement())
   usuarioId Int    @unique
   crm       String @unique

   // Usuário relacionado ao médico
   usuario Usuario @relation(
     fields: [usuarioId],
     references: [id]
   )

   // Pacientes pertencentes ao médico
   pacientes Paciente[]

   // Disponibilidades cadastradas
   // pelo médico na agenda
   disponibilidades DisponibilidadeAgenda[]

   // Consultas/agendamentos relacionados
   // ao médico
   agendamentos Agendamento[]

   // ========================================
   // PRONTUÁRIOS MÉDICOS
   // ========================================

   // Registros clínicos criados pelo médico.
   // São independentes dos agendamentos.
   prontuarios Prontuario[]

   // Credencial adicional para acessar
   // a área de prontuários.
   //
   // Cada médico poderá possuir apenas
   // um registro de acesso adicional.
   acessoProntuario AcessoProntuario?

   // Codigos de recuperacao da senha dos prontuarios.
   codigosRecuperacaoProntuario CodigoRecuperacaoProntuario[]
 }


 // ========================================
 // PACIENTE
 // ========================================

 // Dados dos pacientes cadastrados
 // pelo médico
 model Paciente {
   id        Int  @id @default(autoincrement())
   medicoId  Int
   usuarioId Int? @unique

   nome     String
   email    String?
   telefone String?
   cpf      String? @unique

   // Indica se o médico liberou
   // o acesso do paciente ao sistema
   acessoLiberado Boolean @default(false)

   // Exclusão/bloqueio lógico
   ativo Boolean @default(true)

   // Médico responsável
   medico Medico @relation(
     fields: [medicoId],
     references: [id]
   )

   // Usuário utilizado para login.
   //
   // Pode ser null enquanto o médico ainda
   // não tiver liberado o acesso do paciente.
   usuario Usuario? @relation(
     fields: [usuarioId],
     references: [id]
   )

   // Consultas do paciente
   agendamentos Agendamento[]

   // ========================================
   // HISTÓRICO CLÍNICO
   // ========================================

   // Um paciente existente pode possuir
   // vários prontuários ao longo do tempo.
   //
   // Cada novo registro será preservado
   // independentemente dos anteriores.
   prontuarios Prontuario[]
 }


 // ========================================
 // DISPONIBILIDADE DA AGENDA
 // ========================================

 // Representa os períodos que o médico
 // disponibilizou para atendimento.
 //
 // Exemplo:
 //
 // 15/09/2026
 // 08:00 até 12:00
 // duração de consulta: 30 minutos
 model DisponibilidadeAgenda {
   id Int @id @default(autoincrement())

   medicoId Int
   data     DateString

   horaInicio String
   horaFim    String

   duracaoConsulta Int @default(30)

   // Permite exclusão lógica sem
   // remover o histórico do banco
   ativo Boolean @default(true)

   // Médico proprietário
   medico Medico @relation(
     fields: [medicoId],
     references: [id]
   )

   // Facilita consultas por médico e data
   @@index([medicoId, data])
 }


 // ========================================
 // AGENDAMENTO
 // ========================================

 // Representa uma consulta reservada
 // por um paciente.
 //
 // IMPORTANTE:
 //
 // O paciente só poderá criar um
 // agendamento usando horários que
 // tenham sido disponibilizados
 // anteriormente pelo médico.
 model Agendamento {
   id Int @id @default(autoincrement())

   // Médico da consulta
   medicoId Int

   // Paciente da consulta
   pacienteId Int

   // Data da consulta
   data DateString

   // Horário inicial
   horaInicio String

   // Horário final
   horaFim String

   // Estado atual da consulta
   status StatusAgendamento @default(PENDENTE)

   // Controle de criação e atualização
   createdAt TimestamptzString @default(now())
   updatedAt temporal.updatedAtString()

   // ========================================
   // RELACIONAMENTOS
   // ========================================

   medico Medico @relation(
     fields: [medicoId],
     references: [id]
   )

   paciente Paciente @relation(
     fields: [pacienteId],
     references: [id]
   )

   // Histórico das solicitações de
   // remarcação desta consulta.
   //
   // Uma consulta pode possuir várias
   // solicitações ao longo do tempo.
   remarcacoes RemarcacaoAgendamento[]

   // ========================================
   // ÍNDICES
   // ========================================

   // Usado para buscar rapidamente
   // a agenda diária de um médico
   @@index([medicoId, data])

   // Usado para buscar consultas
   // pertencentes a um paciente
   @@index([pacienteId, data])

   // Ajuda na validação se determinado
   // horário já está ocupado
   @@index([medicoId, data, horaInicio])
 }


 // ========================================
 // REMARCAÇÃO DE AGENDAMENTO
 // ========================================

 // Representa uma solicitação feita
 // pelo paciente para mudar a data
 // e/ou horário de uma consulta.
 //
 // IMPORTANTE:
 //
 // A consulta original NÃO será alterada
 // enquanto o médico não aceitar
 // a solicitação.
 //
 // Exemplo:
 //
 // Consulta atual:
 // 18/09/2026 - 14:00
 //
 // Paciente solicita:
 // 20/09/2026 - 09:30
 //
 // Enquanto estiver PENDENTE,
 // o Agendamento continua apontando
 // para 18/09/2026 - 14:00.
 //
 // Se o médico aceitar, o Agendamento
 // será atualizado para o novo horário.
 //
 // Se recusar, a consulta original
 // continuará normalmente.
 model RemarcacaoAgendamento {
   id Int @id @default(autoincrement())

   // ========================================
   // AGENDAMENTO
   // ========================================

   // Consulta que o paciente
   // deseja remarcar
   agendamentoId Int

   // ========================================
   // NOVO HORÁRIO
   // ========================================

   // Nova data solicitada
   novaData DateString

   // Novo horário inicial solicitado
   novaHoraInicio String

   // Novo horário final solicitado
   novaHoraFim String

   // ========================================
   // STATUS
   // ========================================

   // A solicitação nasce como PENDENTE.
   //
   // Depois o médico poderá alterar para:
   //
   // ACEITA
   // ou
   // RECUSADA
   status StatusRemarcacao @default(PENDENTE)

   // ========================================
   // VISUALIZAÇÃO PELO PACIENTE
   // ========================================

   // Indica se o paciente já visualizou
   // a resposta do médico.
   //
   // Quando o médico aceita ou recusa,
   // permanece false.
   //
   // Assim o frontend consegue mostrar:
   //
   // "Sua remarcação foi aceita"
   //
   // ou
   //
   // "Sua remarcação foi recusada".
   //
   // Quando o paciente clicar em
   // "Entendi", será alterado para true.
   //
   // O registro continua no banco
   // para manter o histórico.
   visualizadoPaciente Boolean @default(false)

   // ========================================
   // CONTROLE
   // ========================================

   createdAt TimestamptzString @default(now())
   updatedAt temporal.updatedAtString()

   // ========================================
   // RELACIONAMENTO
   // ========================================

   agendamento Agendamento @relation(
     fields: [agendamentoId],
     references: [id]
   )

   // ========================================
   // ÍNDICES
   // ========================================

   // Facilita buscar as remarcações
   // de determinada consulta.
   @@index([agendamentoId])

   // Facilita buscar, por exemplo,
   // todas as solicitações PENDENTES.
   @@index([status])
 }


 // ========================================
 // REDEFINIÇÃO DE SENHA
 // ========================================

 // Códigos temporários utilizados
 // exclusivamente na recuperação de senha.
 //
 // Este model continuará responsável pelo:
 //
 // "Esqueci minha senha"
 //
 // Ele NÃO será utilizado para o
 // novo fluxo de primeiro acesso.
 model CodigoRedefinicaoSenha {
   id Int @id @default(autoincrement())

   usuarioId Int

   codigo String

   expiraEm TimestamptzString

   usado Boolean @default(false)

   createdAt TimestamptzString @default(now())

   usuario Usuario @relation(
     fields: [usuarioId],
     references: [id]
   )
 }


 // ========================================
 // PRIMEIRO ACESSO
 // ========================================

 // Códigos temporários utilizados
 // exclusivamente no primeiro acesso.
 //
 // Este fluxo será utilizado quando o
 // usuário ainda NÃO possui senha.
 //
 // Exemplo:
 //
 // Médico libera acesso
 //        ↓
 // Usuario é criado
 // senha = null
 // primeiroAcesso = true
 //        ↓
 // Paciente solicita primeiro acesso
 //        ↓
 // Sistema gera código de 6 dígitos
 //        ↓
 // Código é enviado pela Brevo
 //        ↓
 // Paciente informa:
 // - código
 // - nova senha
 // - confirmação da senha
 //        ↓
 // Backend valida
 //        ↓
 // senha recebe hash bcrypt
 // primeiroAcesso = false
 model CodigoPrimeiroAcesso {
   id Int @id @default(autoincrement())

   // Usuário responsável pelo
   // processo de primeiro acesso.
   usuarioId Int

   // IMPORTANTE:
   //
   // Diferentemente da estrutura antiga
   // de redefinição de senha, neste novo
   // fluxo não armazenaremos diretamente
   // o código de 6 dígitos.
   //
   // O backend irá gerar:
   //
   // 483921
   //
   // mas o banco receberá apenas
   // o hash correspondente.
   codigoHash String

   // Momento em que o código
   // deixa de ser válido.
   expiraEm TimestamptzString

   // Impede que o mesmo código
   // seja utilizado novamente.
   usado Boolean @default(false)

   // Quantidade de tentativas incorretas
   // realizadas com este código.
   //
   // Posteriormente o service limitará
   // a quantidade permitida.
   tentativas Int @default(0)

   // Momento em que o código foi criado.
   //
   // Além do histórico, poderá ser usado
   // para controlar reenvios muito rápidos.
   createdAt TimestamptzString @default(now())

   // ========================================
   // RELACIONAMENTO
   // ========================================

   usuario Usuario @relation(
     fields: [usuarioId],
     references: [id]
   )

   // ========================================
   // ÍNDICES
   // ========================================

   // Facilita localizar rapidamente os
   // códigos pertencentes ao usuário.
   @@index([usuarioId])

   // Facilita a busca pelos códigos
   // ativos/não utilizados do usuário.
   @@index([usuarioId, usado])
 }


 // ========================================
 // ACESSO ADICIONAL AOS PRONTUÁRIOS
 // ========================================

 // Este modelo armazena a credencial extra
 // utilizada pelo médico para acessar
 // a área de prontuários.
 //
 // A senha nunca é salva em texto puro.
 // Apenas o hash bcrypt é armazenado.
 //
 // O relacionamento é de um para um,
 // pois cada médico terá sua própria senha.
 model AcessoProntuario {
   id Int @id @default(autoincrement())

   // Médico proprietário da credencial.
   //
   // @unique impede a criação de mais
   // de uma credencial para o mesmo médico.
   medicoId Int @unique

   // Hash bcrypt da senha de prontuários.
   senhaHash String

   // Incrementada a cada redefinicao para revogar tokens antigos.
   versaoAutorizacao Int @default(0)

   // Data de criação da credencial.
   createdAt TimestamptzString @default(now())

   // Relacionamento obrigatório com Medico.
   medico Medico @relation(
     fields: [medicoId],
     references: [id]
   )
 }


 // ========================================
 // PRONTUÁRIO MÉDICO
 // ========================================

 // Cada registro representa um prontuário
 // clínico salvo pelo médico.
 //
 // IMPORTANTE:
 //
 // O prontuário não depende de agendamentos.
 //
 // Cada novo prontuário será criado como
 // um registro independente no banco.
 //
 // O sistema poderá copiar os dados do
 // registro anterior para um novo formulário,
 // mas não deverá modificar o anterior.
 model Prontuario {
   id Int @id @default(autoincrement())

   // ========================================
   // IDENTIFICAÇÃO
   // ========================================

   // Paciente já cadastrado no sistema.
   pacienteId Int

   // Médico responsável pelo registro.
   //
   // O backend deverá identificar esse
   // médico pelo usuário autenticado.
   // Não confiar em medicoId enviado
   // diretamente pelo frontend.
   medicoId Int

   // ========================================
   // ANAMNESE
   // ========================================

   // Queixa Principal (QP).
   queixaPrincipal String?

   // História da Moléstia Atual (HMA).
   historiaMolestiaAtual String?

   // ========================================
   // HISTÓRIA PATOLÓGICA PREGRESSA
   // ========================================

   // Inclui os antecedentes pessoais,
   // conforme a estrutura definida.
   historiaPatologicaPregressa String?

   // ========================================
   // EXAME FÍSICO
   // ========================================

   // Inclui o campo "Outros".
   exameFisico String?

   // ========================================
   // EXAMES COMPLEMENTARES
   // ========================================

   // Exames realizados e resultados.
   examesComplementares String?

   // ========================================
   // CONDUTA
   // ========================================

   // Orientações, tratamentos e decisões
   // clínicas registradas pelo médico.
   conduta String?

   // ========================================
   // HISTÓRICO
   // ========================================

   // Identifica qual prontuário anterior
   // serviu como referência para copiar
   // informações ao criar este registro.
   //
   // É opcional porque o primeiro
   // prontuário não possui antecessor.
   //
   // O service deverá validar que o
   // registro anterior pertence ao mesmo
   // paciente e médico.
   prontuarioAnteriorId Int?

   // Conteúdo clínico integral, estruturado em JSON
   // e criptografado no backend com AES-256-GCM.
   // Opcional para permitir migração sem perder dados existentes.
   conteudoCriptografado String?

   // Versão do formato da ficha clínica usada no JSON.
   versaoSchema Int @default(1)

   // Identificador da chave criptográfica (não é a chave secreta).
   versaoChave Int @default(1)

   // Data de criação do registro.
   //
   // Os prontuários anteriores não deverão
   // ser alterados ao criar um novo.
   createdAt TimestamptzString @default(now())

   // ========================================
   // RELACIONAMENTOS
   // ========================================

   // Paciente ao qual pertence o prontuário.
   paciente Paciente @relation(
     fields: [pacienteId],
     references: [id]
   )

   // Médico responsável pelo prontuário.
   medico Medico @relation(
     fields: [medicoId],
     references: [id]
   )

   // ========================================
   // ÍNDICES
   // ========================================

   // Facilita buscar o histórico do
   // paciente pela data de criação.
   @@index([pacienteId, createdAt])

   // Facilita buscar os prontuários
   // pertencentes ao médico.
   @@index([medicoId])
 }


 // ========================================
 // RECUPERACAO DA SENHA DOS PRONTUARIOS
 // ========================================

 // Armazena somente o HMAC do codigo de 6 digitos,
 // nunca os digitos enviados ao medico por e-mail.
 // O codigo expira em 10 minutos e e de uso unico.
 model CodigoRecuperacaoProntuario {
   id Int @id @default(autoincrement())

   // Identifica o medico dono da recuperacao.
   medicoId Int

   // HMAC do codigo temporario enviado por e-mail.
   codigoHash String

   // Data/hora de expiracao calculada no backend.
   expiraEm TimestamptzString

   // Codigo utilizado ou invalidado.
   usado Boolean @default(false)

   // Tentativas de validacao mal-sucedidas.
   tentativas Int @default(0)

   createdAt TimestamptzString @default(now())

   medico Medico @relation(
     fields: [medicoId],
     references: [id]
   )

   @@index([medicoId])
   @@index([medicoId, usado])
 }


 // ========================================
 // AUDITORIA DAS OPERAÇÕES DE PRONTUÁRIOS
 // ========================================

 // Guarda metadados de operações, NÃO o conteúdo clínico.
 // Apenas o backend deve inserir registros nesta tabela.
 // A consulta administrativa não deve expor conteúdo médico.
 model AuditoriaProntuario {
   id Int @id @default(autoincrement())

   // Identidade autenticada no momento da operação.
   // Sem FK: preserva evidência mesmo se a conta for desativada.
   usuarioId Int?

   // Identificadores para rastreabilidade (sem conteúdo clínico).
   medicoId Int?
   pacienteId Int?
   prontuarioId Int?

   // Exemplos: CRIAR, CONSULTAR, EXPORTAR_PDF, ACESSO_NEGADO.
   acao String

   // SUCESSO ou FALHA.
   resultado String

   // Identificador aleatório de requisição, caso disponível.
   requisicaoId String?

   // Data/hora gerada pelo banco.
   createdAt TimestamptzString @default(now())

   @@index([createdAt])
   @@index([usuarioId, createdAt])
   @@index([prontuarioId, createdAt])
   @@index([acao, createdAt])
 }

 // ========================================
 // AUDITORIA DA AGENDA MÉDICA
 // ========================================

 // Armazena o histórico de operações
 // realizadas na agenda médica.
 //
 // Exemplos:
 //
 // - criação de disponibilidade;
 // - alteração de disponibilidade;
 // - remoção de disponibilidade;
 // - confirmação de consulta;
 // - cancelamento de consulta;
 // - remarcação de consulta.
 //
 // IMPORTANTE:
 //
 // Esta tabela não armazena prontuários,
 // diagnósticos ou informações clínicas.
 //
 // Os identificadores são mantidos sem
 // relacionamentos obrigatórios para
 // preservar o histórico de auditoria
 // mesmo após alterações nos cadastros.

 model AuditoriaAgenda {

   // ========================================
   // IDENTIFICAÇÃO
   // ========================================

   id Int @id @default(autoincrement())

   // Usuário autenticado que realizou
   // a operação.
   //
   // Pode representar um médico,
   // paciente ou administrador.
   usuarioId Int?

   // Médico relacionado à operação.
   medicoId Int?

   // ========================================
   // REGISTROS RELACIONADOS
   // ========================================

   // Identificador da disponibilidade
   // criada, alterada ou removida.
   disponibilidadeId Int?

   // Identificador do agendamento
   // relacionado à operação.
   agendamentoId Int?

   // ========================================
   // OPERAÇÃO
   // ========================================

   // Exemplos:
   //
   // CRIAR_DISPONIBILIDADE
   // ALTERAR_DISPONIBILIDADE
   // REMOVER_DISPONIBILIDADE
   // CONFIRMAR_CONSULTA
   // CANCELAR_CONSULTA
   // ACEITAR_REMARCACAO
   //
   // Esses valores serão definidos
   // exclusivamente pelo backend.
   acao String

   // Resultado da operação:
   //
   // SUCESSO
   // FALHA
   resultado String

   // ========================================
   // DADOS OPERACIONAIS
   // ========================================

   // Data da agenda relacionada ao evento.
   // Não é a data de criação do log.
   dataAgenda DateString?

   // Horários relacionados à operação.
   horaInicio String?
   horaFim String?

   // ========================================
   // RASTREABILIDADE
   // ========================================

   // Identificador de requisição HTTP.
   // Inicialmente pode permanecer null.
   requisicaoId String?

   // Momento exato do registro.
   // Preenchido automaticamente pelo banco.
   createdAt TimestamptzString @default(now())

   // ========================================
   // ÍNDICES
   // ========================================

   // Consultar atividades recentes.
   @@index([createdAt])

   // Filtrar por médico e período.
   @@index([medicoId, createdAt])

   // Filtrar por usuário responsável.
   @@index([usuarioId, createdAt])

   // Consultar atividades por ação.
   @@index([acao, createdAt])

   // Histórico de uma disponibilidade.
   @@index([disponibilidadeId, createdAt])

   // Histórico de um agendamento.
   @@index([agendamentoId, createdAt])

 }

 // ========================================
 // AUDITORIA DE PACIENTES
 // ========================================

 // Histórico administrativo das operações
 // realizadas pelos médicos nos cadastros
 // de pacientes.
 //
 // Não armazena CPF, e-mail, telefone
 // nem dados clínicos.
 //
 // Não utilizamos chaves estrangeiras
 // obrigatórias porque os registros de
 // auditoria devem permanecer disponíveis
 // mesmo que um paciente seja excluído.

 model AuditoriaPaciente {

   // Identificador único do evento.
   id Int @id @default(autoincrement())

   // Usuário autenticado responsável.
   usuarioId Int?

   // Médico relacionado à operação.
   medicoId Int?

   // Paciente afetado.
   pacienteId Int?

   // Exemplo: CADASTRAR_PACIENTE.
   acao String

   // Exemplo: SUCESSO ou FALHA.
   resultado String

   // Identificador opcional da requisição.
   requisicaoId String?

   // Momento da operação.
   createdAt TimestamptzString @default(now())

   // Índices para consultas administrativas.
   @@index([createdAt])
   @@index([medicoId, createdAt])
   @@index([usuarioId, createdAt])
   @@index([pacienteId, createdAt])
   @@index([acao, createdAt])
 }
// ========================================
// AUDITORIA DE LOGIN E SEGURANÇA
// ========================================

// Registra operações de autenticação.
//
// Não armazena:
// - Senhas
// - Tokens JWT
// - Cookies
// - Códigos de recuperação
//
// usuarioId não possui chave estrangeira,
// permitindo preservar o histórico mesmo
// se uma conta for excluída.
//
// Em tentativas de login com e-mail
// desconhecido, usuarioId será null.

model AuditoriaLogin {

  // Identificador único do evento.
  id Int @id @default(autoincrement())

  // Usuário relacionado ao evento.
  usuarioId Int?

  // Perfil identificado.
  // ADMIN, MEDICO ou PACIENTE.
  perfil String?

  // Tipo da operação:
  // LOGIN_SUCESSO
  // LOGIN_FALHA
  // LOGOUT
  // LOGIN_BLOQUEADO
  acao String

  // SUCESSO ou FALHA.
  resultado String

  // IP de origem da requisição.
  ip String?

  // Identificador opcional da requisição.
  requisicaoId String?

  // Momento do evento.
  createdAt TimestamptzString @default(now())

  // Índices para consultas administrativas.
  @@index([createdAt])
  @@index([usuarioId, createdAt])
  @@index([acao, createdAt])
  @@index([resultado, createdAt])
}
