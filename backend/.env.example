# Banco de dados
DATABASE_URL="postgresql://usuario@localhost:5432/nome_do_banco"

# Administrador inicial do sistema
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@consultorio.com"
ADMIN_SENHA=

# Chave usada para gerar os tokens de autenticação
JWT_SECRET=
# Configure ADMIN_SENHA e JWT_SECRET por segredo privado; nunca copie senhas fixas.
# JWT_SECRET exige ao menos 32 caracteres aleatórios.
