{
  "name": "backend",
  "type": "module",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "dev:test": "node --env-file=.env.test scripts/iniciar-backend-testes.mjs",
    "test:seed": "NODE_ENV=test node --env-file=.env.test --import tsx scripts/criar-usuarios-teste.ts",
    "test:sessions": "NODE_ENV=test node --env-file=.env.test --import tsx --test tests/sessoes-falhas.test.mjs",
    "test:db:plan": "NODE_ENV=test node --env-file=.env.test scripts/aplicar-revogacao-testes.mjs",
    "test:db:apply": "NODE_ENV=test node --env-file=.env.test scripts/aplicar-revogacao-testes.mjs --apply",
    "test:scripts": "NODE_ENV=test node --env-file=.env.test --import tsx src/scripts/testar-criptografia-prontuario.ts && NODE_ENV=test node --env-file=.env.test --import tsx src/scripts/testar-integracao-prontuario.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.2.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.14",
    "prisma": "^8.0.0-rc.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
